# Default provider used when a request omits provider selection.
ARYA_DEFAULT_PROVIDER=gemini

# Optional provider-specific models.
GEMINI_CHAT_MODEL=gemini-2.5-flash
OPENAI_CHAT_MODEL=gpt-4.1-mini

# API credentials are read by the backend process, never by renderer code.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional absolute path to this project's virtual-environment Python executable.
# Example: D:/HeyAgent/.venv/Scripts/python.exe
ARYA_PYTHON=
